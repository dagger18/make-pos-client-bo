msgstr "<a href=\"rates.html\">運賃</a> — 仕入れ・販売価格リスト"

msgid "<a href=\"carrier-tools.html\">Carrier Tools</a> — Schedules and container tracking"
msgstr "<a href=\"carrier-tools.html\">キャリアツール</a> — スケジュールとコンテナ追跡"

msgid "<a href=\"warehouse.html\">Warehouse</a> — CFS and inventory management"
msgstr "<a href=\"warehouse.html\">倉庫</a> — CFS と在庫管理"

msgid "<a href=\"crm.html\">CRM</a> — Sales pipeline and leads"
msgstr "<a href=\"crm.html\">CRM</a> — 営業パイプラインとリード"

