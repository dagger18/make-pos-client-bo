msgstr "<a href=\"consolidations.html\">混載</a> — LCL 輸送をコンテナにまとめる"

msgid "<a href=\"clients.html\">Clients</a> — Customer profiles and billing history"
msgstr "<a href=\"clients.html\">クライアント</a> — 顧客プロフィールと請求履歴"

msgid "<a href=\"providers.html\">Providers</a> — Carrier and vendor management"
msgstr "<a href=\"providers.html\">プロバイダー</a> — キャリアとベンダーの管理"

msgid "<a href=\"accounting.html\">Accounting</a> — Invoices, payments, and financial documents"
msgstr "<a href=\"accounting.html\">会計</a> — 請求書、支払い、財務書類"

