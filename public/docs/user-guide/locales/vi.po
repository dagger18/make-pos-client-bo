msgid "The Accounting module handles all financial documents — invoices, credit notes, payments, and receipts."
msgstr "Mô-đun Kế toán quản lý tất cả các chứng từ tài chính — hóa đơn, ghi có, thanh toán và thu tiền."

msgid "Navigate to <strong>Accounting → SOA-Client</strong> or open a client/provider record and select <strong>Statement of Account</strong>. The SOA shows:"
msgstr "Vào <strong>Kế toán → SOA-Khách hàng</strong> hoặc mở hồ sơ khách hàng/nhà cung cấp và chọn <strong>Sao kê tài khoản</strong>. SOA hiển thị:"

msgid "Export the SOA as PDF or Excel for client review or internal reconciliation."
msgstr "Xuất SOA dưới dạng PDF hoặc Excel để khách hàng xem xét hoặc đối chiếu nội bộ."

msgid "Go to <strong>Accounting → PMT</strong> to record a payment made to a provider, or <strong>Accounting → RPT</strong> to record a payment received from a client. In each case:"
msgstr "Vào <strong>Kế toán → PMT</strong> để ghi nhận khoản thanh toán cho nhà cung cấp, hoặc <strong>Kế toán → RPT</strong> để ghi nhận khoản thu từ khách hàng. Trong mỗi trường hợp:"

msgid "Go to <strong>Accounting → AR Ageing</strong> (receivables) or <strong>AP Ageing</strong> (payables). Select a date range and run the report. Outstanding amounts are grouped by age band:"
msgstr "Vào <strong>Kế toán → Tuổi nợ AR</strong> (phải thu) hoặc <strong>Tuổi nợ AP</strong> (phải trả). Chọn khoảng thời gian và chạy báo cáo. Số dư chưa thanh toán được nhóm theo dải thời gian nợ:"

msgid "Go to <strong>Accounting → Journal</strong> to create manual general ledger entries. Each journal entry requires:"
msgstr "Vào <strong>Kế toán → Nhật ký</strong> để tạo bút toán sổ cái tổng hợp thủ công. Mỗi bút toán nhật ký yêu cầu:"

msgid "Journal entries require approval from an authorised user before they are posted to the general ledger."
msgstr "Bút toán nhật ký cần được người dùng có thẩm quyền phê duyệt trước khi được ghi vào sổ cái tổng hợp."

msgid "Go to <strong>Accounting → P&amp;L Period</strong>. Select a from/to date range and click <strong>Run Report</strong>. The report shows revenue, cost, gross profit, margin %, FX gain/loss, and net profit broken down by branch."
msgstr "Vào <strong>Kế toán → Kỳ P&amp;L</strong>. Chọn khoảng thời gian từ/đến và nhấp <strong>Chạy báo cáo</strong>. Báo cáo hiển thị doanh thu, chi phí, lợi nhuận gộp, tỷ suất lợi nhuận %, lãi/lỗ ngoại tệ và lợi nhuận ròng theo từng chi nhánh."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Accounting → ID</strong> and click <strong>New Invoice</strong>, or create directly from the shipment Cost Sheet tab</span>"
msgstr "<span class=\"step-num\">1</span><span>Vào <strong>Kế toán → ID</strong> và nhấp <strong>Hóa đơn mới</strong>, hoặc tạo trực tiếp từ tab Bảng chi phí của lô hàng</span>"

msgid "<span class=\"step-num\">2</span><span>Select the client and shipment reference</span>"
msgstr "<span class=\"step-num\">2</span><span>Chọn khách hàng và mã tham chiếu lô hàng</span>"

msgid "<span class=\"step-num\">3</span><span>Add charge lines (imported from cost sheet or entered manually)</span>"
msgstr "<span class=\"step-num\">3</span><span>Thêm các dòng phí (nhập từ bảng chi phí hoặc nhập thủ công)</span>"

msgid "<span class=\"step-num\">4</span><span>Set the currency and exchange rate</span>"
msgstr "<span class=\"step-num\">4</span><span>Thiết lập loại tiền tệ và tỷ giá hối đoái</span>"

msgid "<span class=\"step-num\">5</span><span>Save as <strong>Draft</strong>, then click <strong>Submit</strong> to finalise and issue to the client</span>"
msgstr "<span class=\"step-num\">5</span><span>Lưu dưới dạng <strong>Bản nháp</strong>, sau đó nhấp <strong>Gửi</strong> để hoàn tất và phát hành cho khách hàng</span>"

msgid "All invoices and their current status (Draft / Submitted / Approved / Paid)"
msgstr "Tất cả hóa đơn và trạng thái hiện tại (Bản nháp / Đã gửi / Đã duyệt / Đã thanh toán)"

msgid "All payments and the invoices they were applied to"
msgstr "Tất cả các khoản thanh toán và hóa đơn tương ứng"

msgid "Running outstanding balance"
msgstr "Số dư chưa thanh toán lũy kế"

msgid "Multi-currency display with editable exchange rates"
msgstr "Hiển thị đa tiền tệ với tỷ giá có thể chỉnh sửa"

msgid "Create a new record and link it to the relevant invoice(s)"
msgstr "Tạo bản ghi mới và liên kết với (các) hóa đơn liên quan"

msgid "Enter the payment amount, date, and payment method (bank transfer, card, cheque, etc.)"
msgstr "Nhập số tiền thanh toán, ngày và phương thức thanh toán (chuyển khoản ngân hàng, thẻ, séc, v.v.)"

msgid "Save — the outstanding balance on the linked invoice(s) updates automatically"
msgstr "Lưu — số dư chưa thanh toán trên (các) hóa đơn được liên kết sẽ tự động cập nhật"

msgid "Debit and credit account codes from the Chart of Accounts"
msgstr "Mã tài khoản nợ và có từ Sơ đồ tài khoản"

msgid "Description and reference"
msgstr "Mô tả và số tham chiếu"

msgid "Amount and currency"
msgstr "Số tiền và loại tiền tệ"

msgid "Carrier Tools — Make Cargo User Guide"
msgstr "Công cụ hãng vận chuyển — Hướng dẫn sử dụng Make Cargo"

msgid "Vessel Sailing Schedule"
msgstr "Lịch tàu biển"

msgid "Live schedule lookup and container tracking tools integrated with carrier systems."
msgstr "Công cụ tra cứu lịch trình thực tế và theo dõi container được tích hợp với hệ thống hãng vận chuyển."

msgid "Go to <strong>Carriers → Vessel Sailing</strong>. Enter the POL and POD using UN/LOCODE codes (e.g., <code>VNCLI</code> for Ho Chi Minh City), optionally set an ETD start date, and click <strong>Search</strong>."
msgstr "Vào <strong>Hãng vận chuyển → Lịch tàu</strong>. Nhập POL và POD bằng mã UN/LOCODE (ví dụ: <code>VNCLI</code> cho Thành phố Hồ Chí Minh), tùy chọn đặt ngày ETD bắt đầu, và nhấp <strong>Tìm kiếm</strong>."

msgid "Results show:"
msgstr "Kết quả hiển thị:"

msgid "The search covers sailings up to 60 days ahead by default."
msgstr "Mặc định, tìm kiếm bao gồm các chuyến tàu trong vòng 60 ngày tới."

msgid "Go to <strong>Carriers → Flight Schedule</strong>. Enter the origin and destination using IATA airport codes (e.g., <code>SGN</code> for Ho Chi Minh City, <code>HKG</code> for Hong Kong) and select a date. Click <strong>Search</strong> to view available flights, departure and arrival times, and any transit routes."
msgstr "Vào <strong>Hãng vận chuyển → Lịch bay</strong>. Nhập điểm xuất phát và điểm đến bằng mã sân bay IATA (ví dụ: <code>SGN</code> cho Thành phố Hồ Chí Minh, <code>HKG</code> cho Hồng Kông) và chọn ngày. Nhấp <strong>Tìm kiếm</strong> để xem các chuyến bay có sẵn, giờ khởi hành và đến, cùng các tuyến quá cảnh."

msgid "Go to <strong>Carriers → Container Tracking</strong> to view the live tracking status of all containers currently in your system. The list shows:"
msgstr "Vào <strong>Hãng vận chuyển → Theo dõi container</strong> để xem trạng thái theo dõi thực tế của tất cả container hiện có trong hệ thống. Danh sách hiển thị:"

msgid "Click <strong>Refresh</strong> to trigger an immediate status update for all tracked containers across all connected carriers."
msgstr "Nhấp <strong>Làm mới</strong> để kích hoạt cập nhật trạng thái tức thì cho tất cả container đang được theo dõi trên tất cả hãng vận chuyển đã kết nối."

msgid "Vessel name and voyage number"
msgstr "Tên tàu và số chuyến"

msgid "Carrier name"
msgstr "Tên hãng vận chuyển"

msgid "ETD (Estimated Time of Departure) and ETA (Estimated Time of Arrival)"
msgstr "ETD (Ngày dự kiến khởi hành) và ETA (Ngày dự kiến đến)"

msgid "Transit time in days"
msgstr "Thời gian vận chuyển (ngày)"

msgid "Shipment reference and carrier"
msgstr "Mã tham chiếu lô hàng và hãng vận chuyển"

msgid "Container number"
msgstr "Số container"

msgid "Current tracking status and last event description"
msgstr "Trạng thái theo dõi hiện tại và mô tả sự kiện mới nhất"

msgid "Last checked timestamp and any carrier API errors"
msgstr "Thời điểm kiểm tra gần nhất và bất kỳ lỗi API hãng vận chuyển nào"

msgid "Clients — Make Cargo User Guide"
msgstr "Khách hàng — Hướng dẫn sử dụng Make Cargo"

msgid "Adding a Client"
msgstr "Thêm khách hàng"

msgid "Statement of Account (SOA)"
msgstr "Sao kê tài khoản (SOA)"

msgid "Client Portal"
msgstr "Cổng thông tin khách hàng"

msgid "Manage your customer (shipper/importer/exporter) profiles and their billing history."
msgstr "Quản lý hồ sơ khách hàng (người gửi hàng/nhập khẩu/xuất khẩu) và lịch sử thanh toán của họ."

msgid "Open a client record and navigate to <strong>Statement of Account</strong> to view the complete financial history for that client. The SOA shows:"
msgstr "Mở hồ sơ khách hàng và vào <strong>Sao kê tài khoản</strong> để xem toàn bộ lịch sử tài chính của khách hàng đó. SOA hiển thị:"

msgid "You can filter by date range, select the display currency, adjust exchange rates, and export the statement as PDF or Excel."
msgstr "Bạn có thể lọc theo khoảng thời gian, chọn loại tiền tệ hiển thị, điều chỉnh tỷ giá hối đoái và xuất sao kê dưới dạng PDF hoặc Excel."

msgid "Clients can be granted access to a self-service portal where they can view their shipments, download documents, and request new quotes. Portal access is managed from the client profile page — toggle portal access on and set the contact email to use for login."
msgstr "Khách hàng có thể được cấp quyền truy cập vào cổng tự phục vụ, nơi họ có thể xem lô hàng, tải xuống chứng từ và yêu cầu báo giá mới. Quyền truy cập cổng được quản lý từ trang hồ sơ khách hàng — bật quyền truy cập cổng và đặt email liên hệ dùng để đăng nhập."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Clients</strong> and click <strong>New Client</strong></span>"
msgstr "<span class=\"step-num\">1</span><span>Vào <strong>Khách hàng</strong> và nhấp <strong>Khách hàng mới</strong></span>"

msgid "<span class=\"step-num\">2</span><span>Enter company name, contact name, email, phone, and billing address</span>"
msgstr "<span class=\"step-num\">2</span><span>Nhập tên công ty, tên liên hệ, email, điện thoại và địa chỉ thanh toán</span>"

msgid "<span class=\"step-num\">3</span><span>Set the credit tier and credit limit for this client</span>"
msgstr "<span class=\"step-num\">3</span><span>Thiết lập hạng tín dụng và hạn mức tín dụng cho khách hàng này</span>"

msgid "<span class=\"step-num\">4</span><span>Click <strong>Save</strong>. The client is now available when creating quotes and shipments.</span>"
msgstr "<span class=\"step-num\">4</span><span>Nhấp <strong>Lưu</strong>. Khách hàng này hiện có thể được chọn khi tạo báo giá và lô hàng.</span>"

msgid "All invoices and their current payment status"
msgstr "Tất cả hóa đơn và trạng thái thanh toán hiện tại"

msgid "Payments received and the invoices they were applied to"
msgstr "Các khoản đã thu và hóa đơn tương ứng"

msgid "Consolidations — Make Cargo User Guide"
msgstr "Hàng ghép/Gom hàng — Hướng dẫn sử dụng Make Cargo"

msgid "Creating a Consolidation"
msgstr "Tạo lô hàng ghép"

msgid "Consolidation Statuses"
msgstr "Trạng thái hàng ghép"

msgid "Stuffing & Stripping"
msgstr "Đóng hàng & Dỡ hàng"

msgid "Consolidations group multiple LCL (or groupage) shipments into a single container or flight, sharing freight costs across all cargo owners."
msgstr "Hàng ghép/Gom hàng tập hợp nhiều lô hàng LCL (hoặc hàng lẻ) vào một container hoặc chuyến bay, chia sẻ cước phí vận chuyển cho tất cả chủ hàng."

msgid "<strong>Stuffing</strong> records the container loading process at origin — each cargo item and its condition is recorded as it is loaded into the container."
msgstr "<strong>Đóng hàng</strong> ghi nhận quá trình xếp hàng vào container tại điểm xuất phát — mỗi kiện hàng và tình trạng của nó được ghi lại khi xếp vào container."

msgid "<strong>Stripping</strong> records the cargo unloading process at the destination CFS (Container Freight Station) — cargo is checked out and assigned to each consignee. Each individual shipment's cargo items are tracked through this process."
msgstr "<strong>Dỡ hàng</strong> ghi nhận quá trình dỡ hàng tại CFS (Trạm giao nhận container) đích — hàng hóa được kiểm tra và phân bổ cho từng người nhận hàng. Từng kiện hàng của mỗi lô hàng riêng lẻ được theo dõi trong suốt quá trình này."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Consolidations</strong> and click <strong>New Consolidation</strong></span>"
msgstr "<span class=\"step-num\">1</span><span>Vào <strong>Hàng ghép/Gom hàng</strong> và nhấp <strong>Tạo lô hàng ghép mới</strong></span>"

msgid "<span class=\"step-num\">2</span><span>Select transport mode and service type (e.g., Ocean — LCL)</span>"
msgstr "<span class=\"step-num\">2</span><span>Chọn phương thức vận tải và loại dịch vụ (ví dụ: Đường biển — LCL)</span>"

msgid "<span class=\"step-num\">3</span><span>Enter POL, POD, ETD, ETA, vessel/flight details, and container/ULD details</span>"
msgstr "<span class=\"step-num\">3</span><span>Nhập POL, POD, ETD, ETA, thông tin tàu/chuyến bay và chi tiết container/ULD</span>"

msgid "<span class=\"step-num\">4</span><span>Go to the <strong>Manifest</strong> tab and search for existing LCL shipments to attach as child shipments</span>"
msgstr "<span class=\"step-num\">4</span><span>Vào tab <strong>Manifest</strong> và tìm kiếm các lô hàng LCL hiện có để đính kèm làm lô hàng con</span>"

msgid "<strong>Tip:</strong> Close the consolidation before departure to prevent new shipments from being added. Mark the consolidation as <strong>Departed</strong> once the vessel sails, and <strong>Arrived</strong> when cargo is received at destination."
msgstr "<strong>Mẹo:</strong> Đóng lô hàng ghép trước khi khởi hành để ngăn thêm lô hàng mới. Đánh dấu lô hàng ghép là <strong>Đã khởi hành</strong> khi tàu rời bến, và <strong>Đã đến</strong> khi hàng được nhận tại đích."

msgid "CRM — Make Cargo User Guide"
msgstr "CRM — Hướng dẫn sử dụng Make Cargo"

msgid "CRM — Sales Pipeline"
msgstr "CRM — Quy trình bán hàng"

msgid "Leads"
msgstr "Khách hàng tiềm năng"

msgid "Activities"
msgstr "Hoạt động"

msgid "Opportunities"
msgstr "Cơ hội kinh doanh"

msgid "Track leads, manage opportunities, and convert prospects into clients."
msgstr "Theo dõi khách hàng tiềm năng, quản lý cơ hội kinh doanh và chuyển đổi khách hàng tiềm năng thành khách hàng chính thức."

msgid "Log sales activities (calls, meetings, emails) under <strong>CRM → Activities</strong>. Link each activity to a lead or opportunity, record the outcome, and schedule follow-ups. Activity history gives sales managers full visibility into team efforts."
msgstr "Ghi nhật ký hoạt động bán hàng (cuộc gọi, cuộc họp, email) trong <strong>CRM → Hoạt động</strong>. Liên kết từng hoạt động với một khách hàng tiềm năng hoặc cơ hội kinh doanh, ghi lại kết quả và lên lịch theo dõi. Lịch sử hoạt động giúp quản lý bán hàng có toàn bộ thông tin về nỗ lực của đội ngũ."

msgid "Track qualified deals with estimated value and close probability in <strong>CRM → Opportunities</strong>. Opportunities can be linked to a lead or an existing client. Use the pipeline view to track progress through stages and forecast revenue."
msgstr "Theo dõi các thương vụ đã xác nhận với giá trị ước tính và xác suất chốt deal trong <strong>CRM → Cơ hội kinh doanh</strong>. Cơ hội có thể được liên kết với khách hàng tiềm năng hoặc khách hàng hiện có. Sử dụng chế độ xem quy trình để theo dõi tiến độ qua các giai đoạn và dự báo doanh thu."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>CRM → Leads</strong> and click <strong>New Lead</strong></span>"
msgstr "<span class=\"step-num\">1</span><span>Vào <strong>CRM → Khách hàng tiềm năng</strong> và nhấp <strong>Khách hàng tiềm năng mới</strong></span>"

msgid "<span class=\"step-num\">2</span><span>Enter company name, contact details, industry, estimated monthly volume, and lead source (Referral, LinkedIn, Cold Call, etc.)</span>"
msgstr "<span class=\"step-num\">2</span><span>Nhập tên công ty, thông tin liên hệ, ngành nghề, sản lượng hàng tháng ước tính và nguồn tiếp cận (Giới thiệu, LinkedIn, Gọi lạnh, v.v.)</span>"

msgid "<span class=\"step-num\">3</span><span>Assign the lead to a sales staff member and select the transport modes they are interested in</span>"
msgstr "<span class=\"step-num\">3</span><span>Phân công khách hàng tiềm năng cho nhân viên kinh doanh và chọn phương thức vận tải họ quan tâm</span>"

msgid "<span class=\"step-num\">4</span><span>Update the status as the lead progresses: <strong>New → Contacted → Qualified → Converted</strong></span>"
msgstr "<span class=\"step-num\">4</span><span>Cập nhật trạng thái khi khách hàng tiềm năng phát triển: <strong>Mới → Đã liên hệ → Đủ tiêu chuẩn → Đã chuyển đổi</strong></span>"

msgid "<span class=\"step-num\">5</span><span>Once qualified, click <strong>Convert to Client</strong> to automatically create a client profile from the lead data</span>"
msgstr "<span class=\"step-num\">5</span><span>Sau khi đủ tiêu chuẩn, nhấp <strong>Chuyển thành khách hàng</strong> để tự động tạo hồ sơ khách hàng từ dữ liệu khách hàng tiềm năng</span>"

msgid "Dashboard — Make Cargo User Guide"
msgstr "Bảng điều khiển — Hướng dẫn sử dụng Make Cargo"

msgid "Stat Cards"
msgstr "Thẻ thống kê"

msgid "Monthly Trend Chart"
msgstr "Biểu đồ xu hướng hàng tháng"

msgid "Upcoming Arrivals"
msgstr "Hàng sắp đến"

msgid "Active Shipments"
msgstr "Lô hàng đang xử lý"

msgid "The Dashboard is your real-time operational overview showing where your business stands today."
msgstr "Bảng điều khiển là tổng quan vận hành thực tế của bạn, phản ánh tình trạng kinh doanh hiện tại."

msgid "Seven stat cards provide an instant summary of your shipment portfolio:"
msgstr "Bảy thẻ thống kê cung cấp tóm tắt tức thì về danh mục lô hàng của bạn:"

msgid "A bar chart displays shipment volume month by month, giving a clear visual of growth trends or seasonal dips. Hover over a bar to see the exact count for that month."
msgstr "Biểu đồ cột hiển thị khối lượng lô hàng theo từng tháng, cho thấy trực quan rõ ràng xu hướng tăng trưởng hoặc sụt giảm theo mùa. Di chuột qua một cột để xem số lượng chính xác của tháng đó."

msgid "A table lists all shipments with an ETA in the next 7 days, helping operations staff plan for incoming cargo."
msgstr "Bảng liệt kê tất cả lô hàng có ETA trong 7 ngày tới, giúp nhân viên vận hành lên kế hoạch cho hàng đến."

msgid "A quick-view panel shows all in-progress jobs with their current status and assigned client. Click any row to open the full shipment detail."
msgstr "Bảng xem nhanh hiển thị tất cả công việc đang xử lý cùng trạng thái hiện tại và khách hàng được phân công. Nhấp vào bất kỳ hàng nào để mở chi tiết đầy đủ của lô hàng."

msgid "<strong>Active</strong> — shipments currently in progress"
msgstr "<strong>Đang xử lý</strong> — lô hàng hiện đang trong quá trình thực hiện"

msgid "<strong>Pending</strong> — shipments awaiting confirmation or action"
msgstr "<strong>Chờ xử lý</strong> — lô hàng đang chờ xác nhận hoặc thao tác"

msgid "<strong>Confirmed</strong> — booked and confirmed jobs"
msgstr "<strong>Đã xác nhận</strong> — công việc đã đặt chỗ và được xác nhận"

msgid "<strong>Arriving (next 7 days)</strong> — shipments with ETA within one week"
msgstr "<strong>Sắp đến (7 ngày tới)</strong> — lô hàng có ETA trong vòng một tuần"

msgid "<strong>Overdue</strong> — shipments past their expected delivery date"
msgstr "<strong>Quá hạn</strong> — lô hàng đã vượt quá ngày giao hàng dự kiến"

msgid "<strong>Exceptions</strong> — shipments flagged with issues or delays"
msgstr "<strong>Ngoại lệ</strong> — lô hàng được gắn cờ có vấn đề hoặc chậm trễ"

msgid "<strong>Done (this month)</strong> — shipments completed in the current calendar month"
msgstr "<strong>Hoàn thành (tháng này)</strong> — lô hàng đã hoàn thành trong tháng dương lịch hiện tại"

msgid "<strong>Tip:</strong> Clicking any stat card navigates directly to a filtered shipment list showing only the shipments matching that status."
msgstr "<strong>Mẹo:</strong> Nhấp vào bất kỳ thẻ thống kê nào sẽ điều hướng trực tiếp đến danh sách lô hàng đã lọc, chỉ hiển thị các lô hàng khớp với trạng thái đó."

msgid "Overview — Make Cargo User Guide"
msgstr "Tổng quan — Hướng dẫn sử dụng Make Cargo"

msgid "Transport Modes"
msgstr "Phương thức vận tải"

msgid "Typical Workflow"
msgstr "Quy trình làm việc điển hình"

msgid "Jump to a module"
msgstr "Chuyển đến mô-đun"

msgid "Language & RTL Support"
msgstr "Hỗ trợ ngôn ngữ & RTL"

msgid "Make Cargo is an end-to-end freight forwarding back-office platform covering pricing, quoting, shipment execution, financial management, and compliance reporting."
msgstr "Make Cargo là nền tảng back-office toàn diện cho hoạt động giao nhận hàng hóa, bao gồm định giá, báo giá, thực hiện lô hàng, quản lý tài chính và báo cáo tuân thủ."

msgid "<strong>Forgot Password?</strong> Click the \"Forgot Password?\" link on the login page and enter your email address. A password reset link will be sent to your inbox."
msgstr "<strong>Quên mật khẩu?</strong> Nhấp vào liên kết \"Quên mật khẩu?\" trên trang đăng nhập và nhập địa chỉ email của bạn. Một liên kết đặt lại mật khẩu sẽ được gửi đến hộp thư đến của bạn."

msgid "<strong>Invitation Link:</strong> New users receive an invitation email with a link to set their password. The link expires after 48 hours — contact your administrator if it has expired."
msgstr "<strong>Liên kết mời:</strong> Người dùng mới nhận được email mời với liên kết để thiết lập mật khẩu. Liên kết hết hạn sau 48 giờ — hãy liên hệ với quản trị viên nếu liên kết đã hết hạn."

msgid "The left sidebar provides access to all modules. Sub-tabs become visible after opening a module. The top-right corner shows your profile avatar, notification bell, and language switcher. A red badge <span class=\"badge badge-danger\">●</span> appears on items that require attention or have new activity."
msgstr "Thanh bên trái cung cấp quyền truy cập vào tất cả mô-đun. Các tab phụ hiển thị sau khi mở một mô-đun. Góc trên bên phải hiển thị ảnh đại diện, chuông thông báo và bộ chuyển đổi ngôn ngữ của bạn. Huy hiệu đỏ <span class=\"badge badge-danger\">●</span> xuất hiện trên các mục cần chú ý hoặc có hoạt động mới."

msgid "Make Cargo supports multiple languages. Switch your language at any time using the language switcher in the top-right corner of the application."
msgstr "Make Cargo hỗ trợ nhiều ngôn ngữ. Chuyển đổi ngôn ngữ bất cứ lúc nào bằng bộ chuyển đổi ngôn ngữ ở góc trên bên phải của ứng dụng."

msgid "When Arabic is selected, the entire interface switches to right-to-left (RTL) layout — sidebars, text alignment, and flow are all mirrored automatically."
msgstr "Khi chọn tiếng Ả Rập, toàn bộ giao diện chuyển sang bố cục từ phải sang trái (RTL) — thanh bên, căn chỉnh văn bản và luồng đều được phản chiếu tự động."

msgid "Your language preference is saved to your profile and persists across sessions and devices."
msgstr "Tùy chọn ngôn ngữ của bạn được lưu vào hồ sơ và duy trì xuyên suốt các phiên và thiết bị."

