msgid "<span class=\"step-num\">2</span><span>Enter your username (email) and password</span>"
msgstr "<span class=\"step-num\">2</span><span>Ingrese su nombre de usuario (correo electrónico) y contraseña</span>"

msgid "<span class=\"step-num\">3</span><span>Click <strong>Login</strong>. You will be taken to the Dashboard.</span>"
msgstr "<span class=\"step-num\">3</span><span>Haga clic en <strong>Iniciar sesión</strong>. Será dirigido al panel de control.</span>"

msgid "Library — Make Cargo User Guide"
msgstr "Biblioteca — Guía de usuario de Make Cargo"

msgid "Charges"
msgstr "Cargos"

msgid "Trade & Customs"
msgstr "Comercio y aduanas"

msgid "Tax"
msgstr "Impuestos"

msgid "Finance & Insurance"
msgstr "Finanzas y seguros"

msgid "Master reference data used across the system — set up once, available everywhere. Keeping Library data accurate ensures quotes, shipments, and financial documents are consistent and complete."
msgstr "Datos de referencia maestros utilizados en todo el sistema: se configuran una vez y están disponibles en todas partes. Mantener los datos de la biblioteca precisos garantiza que las cotizaciones, los envíos y los documentos financieros sean coherentes y completos."

msgid "<strong>Freight Charges</strong> — base charge definitions by transport mode"
msgstr "<strong>Cargos de flete</strong> — definiciones de cargos base por modo de transporte"

msgid "<strong>Local Charges</strong> — port and documentation fees"
msgstr "<strong>Cargos locales</strong> — tarifas portuarias y de documentación"

msgid "<strong>Customs Charges</strong> — clearance and duty-related charges"
msgstr "<strong>Cargos aduaneros</strong> — cargos por despacho aduanero y aranceles"

msgid "<strong>Service Charges</strong> — insurance, fumigation, labelling, etc."
msgstr "<strong>Cargos por servicio</strong> — seguro, fumigación, etiquetado, etc."

msgid "<strong>HS Codes</strong> — harmonized tariff codes for commodity classification"
msgstr "<strong>Códigos HS</strong> — códigos arancelarios armonizados para la clasificación de mercancías"

msgid "<strong>HS Restrictions</strong> — country-specific import/export restrictions"
msgstr "<strong>Restricciones HS</strong> — restricciones de importación/exportación específicas por país"

msgid "<strong>Duty Rates</strong> — duty rates linked to HS codes by country"
msgstr "<strong>Tipos arancelarios</strong> — aranceles vinculados a códigos HS por país"

msgid "<strong>Incoterms</strong> — FOB, CIF, DDP, EXW, and all standard trade terms"
msgstr "<strong>Incoterms</strong> — FOB, CIF, DDP, EXW y todos los términos comerciales estándar"

msgid "<strong>Tax Groups</strong> — VAT/GST groupings by country"
msgstr "<strong>Grupos fiscales</strong> — agrupaciones de IVA/GST por país"

msgid "<strong>Tax Rules</strong> — zero-rated, exempt, and reverse charge rules"
msgstr "<strong>Reglas fiscales</strong> — reglas de tipo cero, exención e inversión del sujeto pasivo"

msgid "<strong>Tax Exemptions</strong> — client-specific tax exemptions"
msgstr "<strong>Exenciones fiscales</strong> — exenciones fiscales específicas por cliente"

msgid "<strong>Tax Registrations</strong> — company tax IDs by country"
msgstr "<strong>Registros fiscales</strong> — identificaciones fiscales de la empresa por país"

msgid "<strong>Package Types</strong> — container, pallet, carton, and other unit definitions"
msgstr "<strong>Tipos de embalaje</strong> — definiciones de contenedor, palé, caja y otras unidades"

msgid "<strong>Shipment Modes</strong> — FCL, LCL, FTL, LTL, Charter, and more"
msgstr "<strong>Modos de envío</strong> — FCL, LCL, FTL, LTL, Chárter y más"

msgid "<strong>Free Time Agreements</strong> — port free day policies by carrier and port"
msgstr "<strong>Acuerdos de tiempo libre</strong> — políticas de días libres en puerto por transportista y puerto"

msgid "<strong>Carrier Event Mapping</strong> — standardise carrier status codes to system statuses"
msgstr "<strong>Mapeo de eventos de transportistas</strong> — estandarizar los códigos de estado del transportista a estados del sistema"

msgid "<strong>Payment Methods</strong> — bank transfer, card, cheque, and other methods"
msgstr "<strong>Métodos de pago</strong> — transferencia bancaria, tarjeta, cheque y otros métodos"

msgid "<strong>Insurance Policies</strong> — cargo insurance contract details"
msgstr "<strong>Pólizas de seguro</strong> — detalles del contrato de seguro de carga"

msgid "<strong>Cargo Claims</strong> — insurance claim management and tracking"
msgstr "<strong>Reclamaciones de carga</strong> — gestión y seguimiento de reclamaciones de seguro"

msgid "<strong>Sanctions Lists</strong> — restricted parties and sanctioned countries"
msgstr "<strong>Listas de sanciones</strong> — partes restringidas y países sancionados"

msgid "<strong>Emission Factors</strong> — CO₂ coefficients by transport mode for emissions calculations"
msgstr "<strong>Factores de emisión</strong> — coeficientes de CO₂ por modo de transporte para cálculos de emisiones"

msgid "<strong>Data Retention</strong> — archive and purge policies for records management"
msgstr "<strong>Retención de datos</strong> — políticas de archivo y purga para la gestión de registros"

msgid "Providers — Make Cargo User Guide"
msgstr "Proveedores — Guía de usuario de Make Cargo"

msgid "Provider Types"
msgstr "Tipos de proveedores"

msgid "Provider SOA"
msgstr "SOA de proveedor"

msgid "Providers are your logistics service partners — shipping lines, airlines, trucking companies, co-loaders, customs brokers, and other vendors."
msgstr "Los proveedores son sus socios de servicios logísticos: navieras, aerolíneas, empresas de transporte terrestre, co-cargadores, agentes de aduanas y otros vendedores."

msgid "Each provider has a <strong>Statement of Account</strong> showing all cost invoices (IC) and payments made to that provider. Use this to track outstanding payables and reconcile against provider statements."
msgstr "Cada proveedor tiene un <strong>Estado de cuenta</strong> que muestra todas las facturas de costo (IC) y los pagos realizados a ese proveedor. Úselo para rastrear las cuentas por pagar pendientes y conciliar con los estados de cuenta del proveedor."

msgid "You can filter by date range, select display currency, and export as PDF or Excel for reconciliation with your accounts payable team."
msgstr "Puede filtrar por rango de fechas, seleccionar la moneda de visualización y exportar como PDF o Excel para la conciliación con su equipo de cuentas por pagar."

msgid "Quotes — Make Cargo User Guide"
msgstr "Cotizaciones — Guía de usuario de Make Cargo"

msgid "Creating a Quote"
msgstr "Crear una cotización"

msgid "Quote Statuses"
msgstr "Estados de cotización"

msgid "Converting to a Shipment"
msgstr "Convertir en un envío"

msgid "Quote Documents"
msgstr "Documentos de cotización"

msgid "Create and manage shipping quotations. A Quote can be converted into a Shipment once accepted."
msgstr "Cree y gestione cotizaciones de envío. Una cotización puede convertirse en un envío una vez aceptada."

msgid "Open an <strong>Accepted</strong> quote and click <strong>Convert to Shipment</strong>. The system creates a new shipment pre-filled with the quote details — client, route, cargo, and charge lines. Review the details and confirm to complete the conversion."
msgstr "Abra una cotización <strong>Aceptada</strong> y haga clic en <strong>Convertir en envío</strong>. El sistema crea un nuevo envío prellenado con los detalles de la cotización: cliente, ruta, carga y líneas de cargo. Revise los detalles y confirme para completar la conversión."

msgid "The <strong>Preview PDF</strong> button generates a printable quotation document ready to send to the client. You can customise the document header (logo, company details, footer text) via <a href=\"settings.html#global-settings\">Global Settings</a>."
msgstr "El botón <strong>Vista previa PDF</strong> genera un documento de cotización imprimible listo para enviar al cliente. Puede personalizar el encabezado del documento (logotipo, datos de la empresa, texto del pie de página) a través de <a href=\"settings.html#global-settings\">Configuración global</a>."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Quotes</strong> in the sidebar and select a transport mode tab (Ocean, Air, Road, etc.)</span>"
msgstr "<span class=\"step-num\">1</span><span>Vaya a <strong>Cotizaciones</strong> en la barra lateral y seleccione una pestaña de modo de transporte (Marítimo, Aéreo, Terrestre, etc.)</span>"

msgid "<span class=\"step-num\">2</span><span>Click <strong>New Quote</strong></span>"
msgstr "<span class=\"step-num\">2</span><span>Haga clic en <strong>Nueva cotización</strong></span>"

msgid "<span class=\"step-num\">3</span><span>Fill in the client, origin/destination, cargo details, and preferred service type</span>"
msgstr "<span class=\"step-num\">3</span><span>Complete el cliente, origen/destino, detalles de la carga y el tipo de servicio preferido</span>"

msgid "<span class=\"step-num\">4</span><span>Add charge lines (freight, local, customs, service fees). The system can auto-populate from the rate library.</span>"
msgstr "<span class=\"step-num\">4</span><span>Agregue líneas de cargo (flete, local, aduana, tarifas de servicio). El sistema puede completarse automáticamente desde la biblioteca de tarifas.</span>"

msgid "<span class=\"step-num\">5</span><span>Click <strong>Save as Draft</strong> to save for later, or click <strong>Send</strong> to issue the quotation to the client.</span>"
msgstr "<span class=\"step-num\">5</span><span>Haga clic en <strong>Guardar como borrador</strong> para guardar para más tarde, o haga clic en <strong>Enviar</strong> para emitir la cotización al cliente.</span>"

msgid "Rates — Make Cargo User Guide"
msgstr "Tarifas — Guía de usuario de Make Cargo"

msgid "Charge Categories"
msgstr "Categorías de cargos"

msgid "Adding a Rate"
msgstr "Agregar una tarifa"

msgid "Rate Import"
msgstr "Importación de tarifas"

msgid "Markup Rules"
msgstr "Reglas de margen"

msgid "Store your buying and selling price lists. Rates auto-populate charge lines on quotes and shipments, saving time and reducing manual entry errors."
msgstr "Almacene sus listas de precios de compra y venta. Las tarifas rellenan automáticamente las líneas de cargo en cotizaciones y envíos, ahorrando tiempo y reduciendo errores de entrada manual."

msgid "Go to <strong>Rates → Import</strong> to bulk-upload rates from a spreadsheet. This is useful when updating tariffs received from a carrier or overseas agent. Download the import template, fill in your rates, and upload the file."
msgstr "Vaya a <strong>Tarifas → Importar</strong> para cargar tarifas en lote desde una hoja de cálculo. Esto es útil cuando se actualizan los aranceles recibidos de un transportista o agente en el exterior. Descargue la plantilla de importación, complete sus tarifas y cargue el archivo."

msgid "Define automatic markup percentages or fixed amounts to be applied on top of buy rates. Go to <strong>Rates → Markup</strong> and create rules targeting specific client tiers, trade lanes, or charge types. Markup rules are applied automatically when generating sell-side charge lines."
msgstr "Defina porcentajes de margen automáticos o importes fijos que se aplicarán sobre las tarifas de compra. Vaya a <strong>Tarifas → Margen</strong> y cree reglas dirigidas a niveles de clientes específicos, rutas comerciales o tipos de cargo. Las reglas de margen se aplican automáticamente al generar líneas de cargo del lado de venta."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Rates</strong>, select a charge type (Freight / Local / Customs / Service) and transport mode tab</span>"
msgstr "<span class=\"step-num\">1</span><span>Vaya a <strong>Tarifas</strong>, seleccione un tipo de cargo (Flete / Local / Aduanas / Servicio) y la pestaña de modo de transporte</span>"

msgid "<span class=\"step-num\">2</span><span>Click <strong>New Rate</strong></span>"
msgstr "<span class=\"step-num\">2</span><span>Haga clic en <strong>Nueva tarifa</strong></span>"

msgid "<span class=\"step-num\">3</span><span>Enter origin/destination, carrier, currency, rate amount, and effective date range</span>"
msgstr "<span class=\"step-num\">3</span><span>Ingrese origen/destino, transportista, moneda, importe de la tarifa y rango de fechas de vigencia</span>"

msgid "<span class=\"step-num\">4</span><span>Click <strong>Save</strong>. The rate is now available when building quotes and shipments.</span>"
msgstr "<span class=\"step-num\">4</span><span>Haga clic en <strong>Guardar</strong>. La tarifa ya está disponible al crear cotizaciones y envíos.</span>"

msgid "Reports — Make Cargo User Guide"
msgstr "Informes — Guía de usuario de Make Cargo"

msgid "Operations Reports"
msgstr "Informes operativos"

msgid "Finance Reports"
msgstr "Informes financieros"

msgid "Compliance Reports"
msgstr "Informes de cumplimiento"

msgid "Operational, financial, and compliance insights across the business. Most reports require a date range — set From/To dates and click <strong>Run Report</strong>."
msgstr "Información operativa, financiera y de cumplimiento normativo en toda la empresa. La mayoría de los informes requieren un rango de fechas: establezca las fechas De/Hasta y haga clic en <strong>Ejecutar informe</strong>."

msgid "Settings — Make Cargo User Guide"
msgstr "Configuración — Guía de usuario de Make Cargo"

msgid "Company Information"
msgstr "Información de la empresa"

msgid "Branches & Departments"
msgstr "Sucursales y departamentos"

msgid "Chart of Accounts"
msgstr "Plan de cuentas"

msgid "Your Profile"
msgstr "Su perfil"

msgid "Go to <strong>Settings → Users</strong> to manage your team's access:"
msgstr "Vaya a <strong>Configuración → Usuarios</strong> para gestionar el acceso de su equipo:"

msgid "Go to <strong>Settings → Groups</strong> to manage permission groups. For each group you can customise which actions (view, create, edit, delete) are permitted on each module."
msgstr "Vaya a <strong>Configuración → Grupos</strong> para gestionar los grupos de permisos. Para cada grupo puede personalizar qué acciones (ver, crear, editar, eliminar) están permitidas en cada módulo."

msgid "Go to <strong>Settings → Global Setting</strong> for organisation-wide defaults:"
msgstr "Vaya a <strong>Configuración → Ajuste global</strong> para los valores predeterminados de toda la organización:"

msgid "Go to <strong>Settings → Company</strong> to manage your organisation's identity:"
msgstr "Vaya a <strong>Configuración → Empresa</strong> para gestionar la identidad de su organización:"

msgid "<strong>Branches</strong> represent your physical office locations. Each shipment, invoice, and financial document can be assigned to a branch, enabling branch-level reporting and P&amp;L."
msgstr "<strong>Las sucursales</strong> representan sus ubicaciones físicas de oficina. Cada envío, factura y documento financiero puede asignarse a una sucursal, lo que permite informes y PyG a nivel de sucursal."

msgid "<strong>Departments</strong> are cost centres within a branch, useful for department-level P&amp;L reporting and budget allocation."
msgstr "<strong>Los departamentos</strong> son centros de costo dentro de una sucursal, útiles para los informes de PyG a nivel departamental y la asignación de presupuesto."

msgid "Go to <strong>Settings → Chart of Accounts</strong> to define your GL (General Ledger) account structure, covering Assets, Liabilities, Equity, Revenue, and Expenses. These account codes are used for journal entries and financial reporting."
msgstr "Vaya a <strong>Configuración → Plan de cuentas</strong> para definir la estructura de cuentas del libro mayor (GL), que cubre activos, pasivos, patrimonio, ingresos y gastos. Estos códigos de cuenta se utilizan para los asientos contables y la presentación de informes financieros."

msgid "Go to <strong>Settings → Integration Connectors</strong> to configure connections with carrier systems, tracking providers, and trade platforms. Each connector requires:"
msgstr "Vaya a <strong>Configuración → Conectores de integración</strong> para configurar las conexiones con los sistemas de transportistas, proveedores de seguimiento y plataformas comerciales. Cada conector requiere:"

msgid "Click your avatar in the top-right corner of any page to access your profile settings. From here you can:"
msgstr "Haga clic en su avatar en la esquina superior derecha de cualquier página para acceder a la configuración de su perfil. Desde aquí puede:"

msgid "<strong>Invite User</strong> — enter the email address and the user receives an invitation link to set their password"
msgstr "<strong>Invitar usuario</strong> — ingrese la dirección de correo electrónico y el usuario recibirá un enlace de invitación para establecer su contraseña"

msgid "<strong>Assign Groups</strong> — groups define permissions matching the user's role (Operations, Finance, Admin)"
msgstr "<strong>Asignar grupos</strong> — los grupos definen permisos que corresponden al rol del usuario (Operaciones, Finanzas, Administración)"

msgid "<strong>Deactivate User</strong> — toggle a user to Inactive to revoke access without deleting their historical records"
msgstr "<strong>Desactivar usuario</strong> — cambie un usuario a Inactivo para revocar el acceso sin eliminar sus registros históricos"

msgid "<strong>Base Currency</strong> — the default currency used for P&amp;L and reporting"
msgstr "<strong>Moneda base</strong> — la moneda predeterminada utilizada para PyG e informes"

msgid "<strong>Exchange Rates</strong> — set and update FX rates used for multi-currency documents"
msgstr "<strong>Tipos de cambio</strong> — establecer y actualizar los tipos de cambio utilizados para documentos multidivisa"

msgid "<strong>Quote ID Format</strong> — auto-numbering format for quote numbers (e.g., <code>QT-{YYYY}-{SEQ}</code>)"
msgstr "<strong>Formato de ID de cotización</strong> — formato de numeración automática para los números de cotización (p. ej., <code>QT-{YYYY}-{SEQ}</code>)"

msgid "<strong>Shipment ID Format</strong> — auto-numbering format for job numbers"
msgstr "<strong>Formato de ID de envío</strong> — formato de numeración automática para los números de trabajo"

msgid "Company name, logo, and registered address"
msgstr "Nombre de la empresa, logotipo y dirección registrada"

msgid "Legal registration details (company number, tax ID)"
msgstr "Datos de registro legal (número de empresa, identificación fiscal)"

msgid "Banking information used on invoices and payment instructions"
msgstr "Información bancaria utilizada en facturas e instrucciones de pago"

msgid "API credentials provided by the carrier or data provider"
msgstr "Credenciales de API proporcionadas por el transportista o proveedor de datos"

msgid "Data mapping rules to translate carrier status codes into system statuses"
msgstr "Reglas de mapeo de datos para traducir los códigos de estado del transportista en estados del sistema"

msgid "A connection test to verify the integration is active and responding"
msgstr "Una prueba de conexión para verificar que la integración está activa y respondiendo"

msgid "Update your name, email address, and profile photo"
msgstr "Actualice su nombre, dirección de correo electrónico y foto de perfil"

msgid "Change your password"
msgstr "Cambiar su contraseña"

msgid "Set your preferred language"
msgstr "Establecer su idioma preferido"

msgid "Configure notification preferences"
msgstr "Configurar las preferencias de notificación"

msgid "<strong>Tip:</strong> Company logo and details appear on all generated PDF documents — invoices, quotes, packing lists, and SOAs. Keep this information up to date."
msgstr "<strong>Consejo:</strong> El logotipo y los datos de la empresa aparecen en todos los documentos PDF generados: facturas, cotizaciones, listas de empaque y SOAs. Mantenga esta información actualizada."

msgid "Shipments — Make Cargo User Guide"
msgstr "Envíos — Guía de usuario de Make Cargo"

msgid "Creating a Shipment"
msgstr "Crear un envío"

msgid "Shipment Statuses"
msgstr "Estados de envío"

msgid "Replicating a Shipment"
msgstr "Replicar un envío"

msgid "Manifest"
msgstr "Manifiesto"

msgid "Shipments are the core operational unit. Each represents one freight job from origin to destination."
msgstr "Los envíos son la unidad operativa central. Cada uno representa un trabajo de carga desde el origen hasta el destino."

msgid "Each shipment record contains multiple tabs covering all aspects of the freight job:"
msgstr "Cada registro de envío contiene múltiples pestañas que cubren todos los aspectos del trabajo de carga:"

msgid "All billing actions are initiated from the <strong>Cost Sheet</strong> tab of a shipment:"
msgstr "Todas las acciones de facturación se inician desde la pestaña <strong>Hoja de costos</strong> de un envío:"

msgid "Use the <strong>Replicate</strong> action on any shipment to create a new Draft pre-filled with the same details — client, route, cargo, and charge lines. This is useful for recurring trade lanes with the same client."
msgstr "Use la acción <strong>Replicar</strong> en cualquier envío para crear un nuevo borrador prellenado con los mismos detalles: cliente, ruta, carga y líneas de cargo. Esto es útil para rutas comerciales recurrentes con el mismo cliente."

msgid "Navigate to <strong>Shipments → Manifest</strong> to generate a cargo manifest report across multiple shipments for a given vessel or flight. The manifest can be exported as PDF or Excel for submission to carriers or port authorities."
msgstr "Navegue a <strong>Envíos → Manifiesto</strong> para generar un informe de manifiesto de carga a través de múltiples envíos para un buque o vuelo determinado. El manifiesto puede exportarse como PDF o Excel para su presentación a transportistas o autoridades portuarias."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Shipments</strong>, select a transport mode tab, or click <strong>New Shipment</strong> from the Dashboard</span>"
msgstr "<span class=\"step-num\">1</span><span>Vaya a <strong>Envíos</strong>, seleccione una pestaña de modo de transporte, o haga clic en <strong>Nuevo envío</strong> desde el panel de control</span>"

msgid "<span class=\"step-num\">2</span><span>Choose transport mode and service type (FCL, LCL, FTL, LTL, etc.)</span>"
msgstr "<span class=\"step-num\">2</span><span>Elija el modo de transporte y el tipo de servicio (FCL, LCL, FTL, LTL, etc.)</span>"

msgid "<span class=\"step-num\">3</span><span>Enter client, POL (Port of Loading), POD (Port of Discharge), ETD, and ETA</span>"
msgstr "<span class=\"step-num\">3</span><span>Ingrese el cliente, POL (Puerto de carga), POD (Puerto de descarga), ETD y ETA</span>"

msgid "<span class=\"step-num\">4</span><span>Add cargo details: commodity, container count, weight, volume</span>"
msgstr "<span class=\"step-num\">4</span><span>Agregue los detalles de la carga: mercancía, número de contenedores, peso, volumen</span>"

msgid "<span class=\"step-num\">5</span><span>Click <strong>Save</strong>. The shipment is created with status <strong>Draft</strong>.</span>"
msgstr "<span class=\"step-num\">5</span><span>Haga clic en <strong>Guardar</strong>. El envío se crea con el estado <strong>Borrador</strong>.</span>"

msgid "<strong>Generate Debit Note (ID)</strong> — charge the client for sell-side charges"
msgstr "<strong>Generar nota de débito (ID)</strong> — cobrar al cliente los cargos del lado de venta"

msgid "<strong>Generate Credit Note (IC)</strong> — record vendor cost from a provider"
msgstr "<strong>Generar nota de crédito (IC)</strong> — registrar el costo del proveedor"

msgid "<strong>View P&amp;L</strong> — see revenue vs. cost and gross margin for the shipment"
msgstr "<strong>Ver PyG</strong> — ver ingresos vs. costos y margen bruto del envío"

msgid "<strong>Close Accounting</strong> — lock the cost sheet once billing is finalised"
msgstr "<strong>Cerrar contabilidad</strong> — bloquear la hoja de costos una vez finalizada la facturación"

msgid "Warehouse — Make Cargo User Guide"
msgstr "Almacén — Guía de usuario de Make Cargo"

msgid "Facilities"
msgstr "Instalaciones"

msgid "CFS Inventory"
msgstr "Inventario CFS"

msgid "Go to <strong>Warehouse → Facilities</strong> to manage CFS (Container Freight Station) and warehouse locations."
msgstr "Vaya a <strong>Almacén → Instalaciones</strong> para gestionar las ubicaciones de CFS (Container Freight Station) y almacén."

msgid "Go to <strong>Warehouse → Inventory</strong> and select a facility to view all cargo items currently in that location. Each item shows its condition on receipt:"
msgstr "Vaya a <strong>Almacén → Inventario</strong> y seleccione una instalación para ver todos los artículos de carga actualmente en esa ubicación. Cada artículo muestra su condición al momento de recepción:"

msgid "Inventory records link back to the originating shipment, making it easy to raise claims or exceptions directly from the warehouse view."
msgstr "Los registros de inventario se vinculan al envío de origen, lo que facilita presentar reclamaciones o excepciones directamente desde la vista del almacén."

msgid "Create facilities with name, location code, address, total area (sqm), and contact details"
msgstr "Cree instalaciones con nombre, código de ubicación, dirección, área total (m²) y datos de contacto"

msgid "Mark facilities as <strong>Bonded</strong> or approved for <strong>Dangerous Goods</strong>"
msgstr "Marque las instalaciones como <strong>Depósito aduanero</strong> o aprobadas para <strong>Mercancías peligrosas</strong>"

msgid "Track reefer capacity for temperature-controlled cargo"
msgstr "Realice el seguimiento de la capacidad frigorífica para carga controlada por temperatura"
