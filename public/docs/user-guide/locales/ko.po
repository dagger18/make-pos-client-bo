msgid "The Accounting module handles all financial documents — invoices, credit notes, payments, and receipts."
msgstr "회계 모듈은 인보이스, 크레딧 노트, 지급, 영수증 등 모든 재무 문서를 관리합니다."

msgid "Navigate to <strong>Accounting → SOA-Client</strong> or open a client/provider record and select <strong>Statement of Account</strong>. The SOA shows:"
msgstr "<strong>회계 → SOA-Client</strong>로 이동하거나 클라이언트/공급업체 레코드를 열고 <strong>거래 명세서</strong>를 선택하세요. SOA에는 다음이 표시됩니다："

msgid "Export the SOA as PDF or Excel for client review or internal reconciliation."
msgstr "클라이언트 검토 또는 내부 대사를 위해 SOA를 PDF 또는 Excel로 내보낼 수 있습니다."

msgid "Go to <strong>Accounting → PMT</strong> to record a payment made to a provider, or <strong>Accounting → RPT</strong> to record a payment received from a client. In each case:"
msgstr "공급업체에 대한 지급을 기록하려면 <strong>회계 → PMT</strong>로, 클라이언트로부터 수금을 기록하려면 <strong>회계 → RPT</strong>로 이동하세요. 각 경우："

msgid "Go to <strong>Accounting → AR Ageing</strong> (receivables) or <strong>AP Ageing</strong> (payables). Select a date range and run the report. Outstanding amounts are grouped by age band:"
msgstr "<strong>회계 → AR Ageing</strong>（매출채권）또는 <strong>AP Ageing</strong>（매입채무）으로 이동하세요. 날짜 범위를 선택하고 보고서를 실행합니다. 미지급 금액은 경과 기간별로 그룹화됩니다："

msgid "Go to <strong>Accounting → Journal</strong> to create manual general ledger entries. Each journal entry requires:"
msgstr "수동으로 총계정원장 분개를 생성하려면 <strong>회계 → Journal</strong>로 이동하세요. 각 분개 입력에는 다음이 필요합니다："

msgid "Journal entries require approval from an authorised user before they are posted to the general ledger."
msgstr "분개는 총계정원장에 전기되기 전에 권한 있는 사용자의 승인이 필요합니다."

msgid "Go to <strong>Accounting → P&amp;L Period</strong>. Select a from/to date range and click <strong>Run Report</strong>. The report shows revenue, cost, gross profit, margin %, FX gain/loss, and net profit broken down by branch."
msgstr "<strong>회계 → P&amp;L Period</strong>로 이동하세요. 시작/종료 날짜 범위를 선택하고 <strong>보고서 실행</strong>을 클릭합니다. 보고서는 지점별로 분류된 수익, 비용, 매출총이익, 이익률 %, 환차손익, 순이익을 표시합니다."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Accounting → ID</strong> and click <strong>New Invoice</strong>, or create directly from the shipment Cost Sheet tab</span>"
msgstr "<span class=\"step-num\">1</span><span><strong>회계 → ID</strong>로 이동하여 <strong>새 인보이스</strong>를 클릭하거나, 화물 운송의 원가 계산서 탭에서 직접 생성합니다</span>"

msgid "<span class=\"step-num\">2</span><span>Select the client and shipment reference</span>"
msgstr "<span class=\"step-num\">2</span><span>클라이언트와 운송 참조 번호를 선택합니다</span>"

msgid "<span class=\"step-num\">3</span><span>Add charge lines (imported from cost sheet or entered manually)</span>"
msgstr "<span class=\"step-num\">3</span><span>요금 항목을 추가합니다（원가 계산서에서 가져오거나 수동으로 입력）</span>"

msgid "<span class=\"step-num\">4</span><span>Set the currency and exchange rate</span>"
msgstr "<span class=\"step-num\">4</span><span>통화와 환율을 설정합니다</span>"

msgid "<span class=\"step-num\">5</span><span>Save as <strong>Draft</strong>, then click <strong>Submit</strong> to finalise and issue to the client</span>"
msgstr "<span class=\"step-num\">5</span><span><strong>임시저장</strong>으로 저장한 후 <strong>제출</strong>을 클릭하여 확정하고 클라이언트에게 발행합니다</span>"

msgid "All invoices and their current status (Draft / Submitted / Approved / Paid)"
msgstr "모든 인보이스와 현재 상태（임시저장 / 제출됨 / 승인됨 / 지급됨）"

msgid "All payments and the invoices they were applied to"
msgstr "모든 지급 내역과 해당 인보이스"

msgid "Running outstanding balance"
msgstr "누계 미결제 잔액"

msgid "Multi-currency display with editable exchange rates"
msgstr "편집 가능한 환율을 사용한 다중 통화 표시"

msgid "Create a new record and link it to the relevant invoice(s)"
msgstr "새 레코드를 생성하고 관련 인보이스에 연결합니다"

msgid "Enter the payment amount, date, and payment method (bank transfer, card, cheque, etc.)"
msgstr "지급 금액, 날짜, 결제 방법（계좌이체, 카드, 수표 등）을 입력합니다"

msgid "Save — the outstanding balance on the linked invoice(s) updates automatically"
msgstr "저장하면 연결된 인보이스의 미결제 잔액이 자동으로 업데이트됩니다"

msgid "Debit and credit account codes from the Chart of Accounts"
msgstr "계정과목표에서 차변 및 대변 계정 코드"

msgid "Description and reference"
msgstr "적요 및 참조"

msgid "Amount and currency"
msgstr "금액 및 통화"

msgid "Carrier Tools — Make Cargo User Guide"
msgstr "운송사 도구 — Make Cargo 사용 가이드"

msgid "Vessel Sailing Schedule"
msgstr "선박 운항 스케줄"

msgid "Live schedule lookup and container tracking tools integrated with carrier systems."
msgstr "운송사 시스템과 연동된 실시간 스케줄 조회 및 컨테이너 추적 도구."

msgid "Go to <strong>Carriers → Vessel Sailing</strong>. Enter the POL and POD using UN/LOCODE codes (e.g., <code>VNCLI</code> for Ho Chi Minh City), optionally set an ETD start date, and click <strong>Search</strong>."
msgstr "<strong>운송사 → 선박 스케줄</strong>로 이동하세요. UN/LOCODE 코드를 사용하여 POL과 POD를 입력하고（예：호치민시는 <code>VNCLI</code>）, 필요에 따라 ETD 시작일을 설정한 후 <strong>검색</strong>을 클릭합니다."

msgid "Results show:"
msgstr "검색 결과에는 다음이 표시됩니다："

msgid "The search covers sailings up to 60 days ahead by default."
msgstr "검색은 기본적으로 60일 이내의 출항을 대상으로 합니다."

msgid "Go to <strong>Carriers → Flight Schedule</strong>. Enter the origin and destination using IATA airport codes (e.g., <code>SGN</code> for Ho Chi Minh City, <code>HKG</code> for Hong Kong) and select a date. Click <strong>Search</strong> to view available flights, departure and arrival times, and any transit routes."
msgstr "<strong>운송사 → 항공 스케줄</strong>로 이동하세요. IATA 공항 코드를 사용하여 출발지와 목적지를 입력하고（예：호치민시는 <code>SGN</code>，홍콩은 <code>HKG</code>）날짜를 선택합니다. <strong>검색</strong>을 클릭하면 이용 가능한 항공편, 출발·도착 시간, 경유 노선을 확인할 수 있습니다."

msgid "Go to <strong>Carriers → Container Tracking</strong> to view the live tracking status of all containers currently in your system. The list shows:"
msgstr "<strong>운송사 → 컨테이너 추적</strong>으로 이동하여 시스템에 있는 모든 컨테이너의 실시간 추적 상태를 확인하세요. 목록에는 다음이 표시됩니다："

msgid "Click <strong>Refresh</strong> to trigger an immediate status update for all tracked containers across all connected carriers."
msgstr "<strong>새로 고침</strong>을 클릭하면 연결된 모든 운송사의 추적 컨테이너 상태가 즉시 업데이트됩니다."

msgid "Vessel name and voyage number"
msgstr "선박명 및 항차 번호"

msgid "Carrier name"
msgstr "운송사명"

msgid "ETD (Estimated Time of Departure) and ETA (Estimated Time of Arrival)"
msgstr "ETD（출항 예정일시）및 ETA（입항 예정일시）"

msgid "Transit time in days"
msgstr "운송 소요 일수"

msgid "Shipment reference and carrier"
msgstr "운송 참조 번호 및 운송사"

msgid "Container number"
msgstr "컨테이너 번호"

msgid "Current tracking status and last event description"
msgstr "현재 추적 상태 및 최근 이벤트 설명"

msgid "Last checked timestamp and any carrier API errors"
msgstr "마지막 확인 시간 및 운송사 API 오류"

msgid "Clients — Make Cargo User Guide"
msgstr "클라이언트 — Make Cargo 사용 가이드"

msgid "Adding a Client"
msgstr "클라이언트 추가"

msgid "Statement of Account (SOA)"
msgstr "거래 명세서 (SOA)"

msgid "Client Portal"
msgstr "클라이언트 포털"

msgid "Manage your customer (shipper/importer/exporter) profiles and their billing history."
msgstr "고객（화주/수입업체/수출업체）프로필과 청구 내역을 관리합니다."

msgid "Open a client record and navigate to <strong>Statement of Account</strong> to view the complete financial history for that client. The SOA shows:"
msgstr "클라이언트 레코드를 열고 <strong>거래 명세서</strong>로 이동하여 해당 클라이언트의 전체 재무 내역을 확인하세요. SOA에는 다음이 표시됩니다："

msgid "You can filter by date range, select the display currency, adjust exchange rates, and export the statement as PDF or Excel."
msgstr "날짜 범위로 필터링하고, 표시 통화를 선택하고, 환율을 조정하고, 명세서를 PDF 또는 Excel로 내보낼 수 있습니다."

msgid "Clients can be granted access to a self-service portal where they can view their shipments, download documents, and request new quotes. Portal access is managed from the client profile page — toggle portal access on and set the contact email to use for login."
msgstr "클라이언트에게 셀프서비스 포털 접근 권한을 부여할 수 있으며, 운송 현황 확인, 문서 다운로드, 새 견적 요청이 가능합니다. 포털 접근은 클라이언트 프로필 페이지에서 관리합니다. 포털 접근을 활성화하고 로그인에 사용할 연락처 이메일을 설정하세요."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Clients</strong> and click <strong>New Client</strong></span>"
msgstr "<span class=\"step-num\">1</span><span><strong>클라이언트</strong>로 이동하여 <strong>새 클라이언트</strong>를 클릭합니다</span>"

msgid "<span class=\"step-num\">2</span><span>Enter company name, contact name, email, phone, and billing address</span>"
msgstr "<span class=\"step-num\">2</span><span>회사명, 담당자명, 이메일, 전화번호, 청구지 주소를 입력합니다</span>"

msgid "<span class=\"step-num\">3</span><span>Set the credit tier and credit limit for this client</span>"
msgstr "<span class=\"step-num\">3</span><span>이 클라이언트의 신용 등급과 신용 한도를 설정합니다</span>"

msgid "<span class=\"step-num\">4</span><span>Click <strong>Save</strong>. The client is now available when creating quotes and shipments.</span>"
msgstr "<span class=\"step-num\">4</span><span><strong>저장</strong>을 클릭합니다. 이제 견적 및 운송 생성 시 이 클라이언트를 선택할 수 있습니다.</span>"

msgid "All invoices and their current payment status"
msgstr "모든 인보이스와 현재 결제 상태"

msgid "Payments received and the invoices they were applied to"
msgstr "수금 내역과 해당 인보이스"

msgid "Consolidations — Make Cargo User Guide"
msgstr "혼재 — Make Cargo 사용 가이드"

msgid "Creating a Consolidation"
msgstr "혼재 생성"

msgid "Consolidation Statuses"
msgstr "혼재 상태"

msgid "Stuffing & Stripping"
msgstr "적입 & 적출"

msgid "Consolidations group multiple LCL (or groupage) shipments into a single container or flight, sharing freight costs across all cargo owners."
msgstr "혼재는 여러 LCL（또는 혼재）화물을 하나의 컨테이너 또는 항공편으로 묶어 모든 화주가 운임을 분담합니다."

msgid "<strong>Stuffing</strong> records the container loading process at origin — each cargo item and its condition is recorded as it is loaded into the container."
msgstr "<strong>적입（Stuffing）</strong>은 출발지에서의 컨테이너 적재 과정을 기록합니다. 각 화물 품목과 상태가 컨테이너에 적재될 때 기록됩니다."

msgid "<strong>Stripping</strong> records the cargo unloading process at the destination CFS (Container Freight Station) — cargo is checked out and assigned to each consignee. Each individual shipment's cargo items are tracked through this process."
msgstr "<strong>적출（Stripping）</strong>은 목적지 CFS（Container Freight Station）에서의 화물 하역 과정을 기록합니다. 화물이 확인되고 각 수하인에게 배정됩니다. 각 개별 운송의 화물 품목이 이 과정을 통해 추적됩니다."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>Consolidations</strong> and click <strong>New Consolidation</strong></span>"
msgstr "<span class=\"step-num\">1</span><span><strong>혼재</strong>로 이동하여 <strong>새 혼재</strong>를 클릭합니다</span>"

msgid "<span class=\"step-num\">2</span><span>Select transport mode and service type (e.g., Ocean — LCL)</span>"
msgstr "<span class=\"step-num\">2</span><span>운송 모드와 서비스 유형을 선택합니다（예：해상 — LCL）</span>"

msgid "<span class=\"step-num\">3</span><span>Enter POL, POD, ETD, ETA, vessel/flight details, and container/ULD details</span>"
msgstr "<span class=\"step-num\">3</span><span>POL, POD, ETD, ETA, 선박/항공편 정보, 컨테이너/ULD 정보를 입력합니다</span>"

msgid "<span class=\"step-num\">4</span><span>Go to the <strong>Manifest</strong> tab and search for existing LCL shipments to attach as child shipments</span>"
msgstr "<span class=\"step-num\">4</span><span><strong>적하목록</strong> 탭으로 이동하여 하위 운송으로 연결할 기존 LCL 운송을 검색합니다</span>"

msgid "<strong>Tip:</strong> Close the consolidation before departure to prevent new shipments from being added. Mark the consolidation as <strong>Departed</strong> once the vessel sails, and <strong>Arrived</strong> when cargo is received at destination."
msgstr "<strong>팁：</strong> 새 운송이 추가되지 않도록 출발 전에 혼재를 마감하세요. 선박이 출항하면 혼재를 <strong>출항됨</strong>으로, 목적지에서 화물이 수령되면 <strong>도착됨</strong>으로 표시하세요."

msgid "CRM — Make Cargo User Guide"
msgstr "CRM — Make Cargo 사용 가이드"

msgid "CRM — Sales Pipeline"
msgstr "CRM — 영업 파이프라인"

msgid "Leads"
msgstr "리드"

msgid "Activities"
msgstr "활동"

msgid "Opportunities"
msgstr "영업 기회"

msgid "Track leads, manage opportunities, and convert prospects into clients."
msgstr "리드를 추적하고, 영업 기회를 관리하고, 잠재 고객을 클라이언트로 전환합니다."

msgid "Log sales activities (calls, meetings, emails) under <strong>CRM → Activities</strong>. Link each activity to a lead or opportunity, record the outcome, and schedule follow-ups. Activity history gives sales managers full visibility into team efforts."
msgstr "<strong>CRM → 활동</strong>에서 영업 활동（전화, 회의, 이메일）을 기록합니다. 각 활동을 리드 또는 영업 기회에 연결하고, 결과를 기록하고, 후속 일정을 예약합니다. 활동 이력을 통해 영업 관리자는 팀의 노력을 전체적으로 파악할 수 있습니다."

msgid "Track qualified deals with estimated value and close probability in <strong>CRM → Opportunities</strong>. Opportunities can be linked to a lead or an existing client. Use the pipeline view to track progress through stages and forecast revenue."
msgstr "<strong>CRM → 영업 기회</strong>에서 예상 금액 및 성사 확률과 함께 유망 거래를 추적합니다. 영업 기회는 리드 또는 기존 클라이언트에 연결할 수 있습니다. 파이프라인 뷰를 사용하여 단계별 진행 상황을 추적하고 매출을 예측합니다."

msgid "<span class=\"step-num\">1</span><span>Go to <strong>CRM → Leads</strong> and click <strong>New Lead</strong></span>"
msgstr "<span class=\"step-num\">1</span><span><strong>CRM → 리드</strong>로 이동하여 <strong>새 리드</strong>를 클릭합니다</span>"

msgid "<span class=\"step-num\">2</span><span>Enter company name, contact details, industry, estimated monthly volume, and lead source (Referral, LinkedIn, Cold Call, etc.)</span>"
msgstr "<span class=\"step-num\">2</span><span>회사명, 연락처 정보, 업종, 예상 월간 물동량, 리드 출처（추천, LinkedIn, 콜드 콜 등）를 입력합니다</span>"

msgid "<span class=\"step-num\">3</span><span>Assign the lead to a sales staff member and select the transport modes they are interested in</span>"
msgstr "<span class=\"step-num\">3</span><span>리드를 영업 담당자에게 배정하고 관심 있는 운송 모드를 선택합니다</span>"

msgid "<span class=\"step-num\">4</span><span>Update the status as the lead progresses: <strong>New → Contacted → Qualified → Converted</strong></span>"
msgstr "<span class=\"step-num\">4</span><span>리드의 진행 상황에 따라 상태를 업데이트합니다：<strong>신규 → 연락됨 → 유망 → 전환됨</strong></span>"

msgid "<span class=\"step-num\">5</span><span>Once qualified, click <strong>Convert to Client</strong> to automatically create a client profile from the lead data</span>"
msgstr "<span class=\"step-num\">5</span><span>유망 단계가 되면 <strong>클라이언트로 전환</strong>을 클릭하여 리드 데이터에서 클라이언트 프로필을 자동으로 생성합니다</span>"

msgid "Dashboard — Make Cargo User Guide"
msgstr "대시보드 — Make Cargo 사용 가이드"

msgid "Stat Cards"
msgstr "통계 카드"

msgid "Monthly Trend Chart"
msgstr "월별 추세 차트"

msgid "Upcoming Arrivals"
msgstr "도착 예정 화물"

msgid "Active Shipments"
msgstr "진행 중인 운송"

msgid "The Dashboard is your real-time operational overview showing where your business stands today."
msgstr "대시보드는 현재 비즈니스 현황을 실시간으로 보여주는 운영 개요 화면입니다."

msgid "Seven stat cards provide an instant summary of your shipment portfolio:"
msgstr "7개의 통계 카드가 운송 포트폴리오 현황을 즉시 요약하여 표시합니다："

msgid "A bar chart displays shipment volume month by month, giving a clear visual of growth trends or seasonal dips. Hover over a bar to see the exact count for that month."
msgstr "막대 차트가 월별 운송량을 표시하여 성장 추세 또는 계절적 감소를 시각적으로 명확하게 확인할 수 있습니다. 막대 위에 마우스를 올리면 해당 월의 정확한 건수가 표시됩니다."

msgid "A table lists all shipments with an ETA in the next 7 days, helping operations staff plan for incoming cargo."
msgstr "표에는 향후 7일 이내에 ETA가 있는 모든 운송이 나열되어 운영 직원이 입고 화물 계획을 수립하는 데 도움이 됩니다."

msgid "A quick-view panel shows all in-progress jobs with their current status and assigned client. Click any row to open the full shipment detail."
msgstr "빠른 보기 패널에는 진행 중인 모든 건의 현재 상태와 담당 클라이언트가 표시됩니다. 임의의 행을 클릭하면 운송 상세 정보가 열립니다."

msgid "<strong>Active</strong> — shipments currently in progress"
msgstr "<strong>진행 중（Active）</strong> — 현재 진행 중인 운송"

msgid "<strong>Pending</strong> — shipments awaiting confirmation or action"
msgstr "<strong>대기 중（Pending）</strong> — 확인 또는 조치를 기다리는 운송"

msgid "<strong>Confirmed</strong> — booked and confirmed jobs"
msgstr "<strong>확정됨（Confirmed）</strong> — 예약 및 확정된 건"

msgid "<strong>Arriving (next 7 days)</strong> — shipments with ETA within one week"
msgstr "<strong>도착 예정（다음 7일）</strong> — 1주일 이내에 ETA가 있는 운송"

msgid "<strong>Overdue</strong> — shipments past their expected delivery date"
msgstr "<strong>기한 초과（Overdue）</strong> — 예상 납기일을 초과한 운송"

msgid "<strong>Exceptions</strong> — shipments flagged with issues or delays"
msgstr "<strong>예외（Exceptions）</strong> — 문제 또는 지연이 신고된 운송"

msgid "<strong>Done (this month)</strong> — shipments completed in the current calendar month"
msgstr "<strong>완료（이번 달）</strong> — 이번 달력 월에 완료된 운송"

msgid "<strong>Tip:</strong> Clicking any stat card navigates directly to a filtered shipment list showing only the shipments matching that status."
msgstr "<strong>팁：</strong> 통계 카드를 클릭하면 해당 상태에 일치하는 운송만 표시한 필터링된 운송 목록으로 바로 이동합니다."

msgid "Overview — Make Cargo User Guide"
msgstr "개요 — Make Cargo 사용 가이드"

msgid "Transport Modes"
msgstr "운송 모드"

msgid "Typical Workflow"
msgstr "일반적인 워크플로"

msgid "Jump to a module"
msgstr "모듈로 이동"

msgid "Language & RTL Support"
msgstr "언어 & RTL 지원"

msgid "Make Cargo is an end-to-end freight forwarding back-office platform covering pricing, quoting, shipment execution, financial management, and compliance reporting."
msgstr "Make Cargo는 요금 설정, 견적, 운송 실행, 재무 관리, 컴플라이언스 보고를 포괄하는 엔드투엔드 화물 운송 백오피스 플랫폼입니다."

msgid "<strong>Forgot Password?</strong> Click the \"Forgot Password?\" link on the login page and enter your email address. A password reset link will be sent to your inbox."
msgstr "<strong>비밀번호를 잊으셨나요？</strong> 로그인 페이지의 \"비밀번호를 잊으셨나요？\" 링크를 클릭하고 이메일 주소를 입력하세요. 비밀번호 재설정 링크가 받은 편지함으로 전송됩니다."

msgid "<strong>Invitation Link:</strong> New users receive an invitation email with a link to set their password. The link expires after 48 hours — contact your administrator if it has expired."
msgstr "<strong>초대 링크：</strong> 신규 사용자는 비밀번호를 설정하는 링크가 포함된 초대 이메일을 받습니다. 링크는 48시간 후에 만료됩니다. 만료된 경우 관리자에게 문의하세요."

msgid "The left sidebar provides access to all modules. Sub-tabs become visible after opening a module. The top-right corner shows your profile avatar, notification bell, and language switcher. A red badge <span class=\"badge badge-danger\">●</span> appears on items that require attention or have new activity."
msgstr "왼쪽 사이드바에서 모든 모듈에 접근할 수 있습니다. 모듈을 열면 하위 탭이 표시됩니다. 오른쪽 상단에는 프로필 아바타, 알림 벨, 언어 전환기가 표시됩니다. 주의가 필요하거나 새 활동이 있는 항목에는 빨간 배지 <span class=\"badge badge-danger\">●</span>가 표시됩니다."

msgid "Make Cargo supports multiple languages. Switch your language at any time using the language switcher in the top-right corner of the application."
msgstr "Make Cargo는 여러 언어를 지원합니다. 애플리케이션 오른쪽 상단의 언어 전환기를 사용하여 언제든지 언어를 변경할 수 있습니다."

msgid "When Arabic is selected, the entire interface switches to right-to-left (RTL) layout — sidebars, text alignment, and flow are all mirrored automatically."
msgstr "아랍어를 선택하면 전체 인터페이스가 오른쪽에서 왼쪽（RTL）레이아웃으로 전환됩니다. 사이드바, 텍스트 정렬, 흐름이 모두 자동으로 반전됩니다."

msgid "Your language preference is saved to your profile and persists across sessions and devices."
msgstr "언어 설정은 프로필에 저장되며 세션 및 기기를 넘어 유지됩니다."

