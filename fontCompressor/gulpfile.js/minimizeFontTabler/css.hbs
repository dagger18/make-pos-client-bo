@font-face {
font-family: "{{ name }}";
src: {{{ fontSrc }}};
font-display: swap;
}

[class*="tabler-"]:before {
font-family: {{ name }} !important;
font-style: normal;
font-weight: normal !important;
font-variant: normal;
text-transform: none;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
display: inherit;
}
[class*="tabler-"]:after {
display: none;
}

{{# each codepoints }}
.{{ ../prefix }}-{{ @key }}:before {
content: "\\{{ codepoint this }}";
}
{{/ each }}
